<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheel_open_loop</name>
  <version>0.1.0</version>
  <description>
    Open-loop baseline for the two-wheel base: maps cmd_vel straight to left and
    right PWM with no IMU feedback, for comparison against wheel_control.
  </description>
  <maintainer email="thienductang@gmail.com">dan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- serial protocol to the ESP32 lives in wheel_control.motor_link -->
  <exec_depend>wheel_control</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
